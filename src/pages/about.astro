---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import { SITE } from '@/site.config';

const tools = ['Python', 'Networking', 'Cryptography', 'Critical Thinking', 'Web'];
---

<BaseLayout title="About" description={`A bit about ${SITE.name} and how they work.`}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <p class="text-ink-soft mb-6 font-mono text-xs tracking-[0.2em] uppercase">About</p>

    <h1 class="font-display text-ink max-w-xl text-3xl font-medium sm:text-4xl">
      {SITE.role}.
    </h1>

    <div class="prose prose-sm sm:prose-base mt-8 max-w-xl">
      <p>
        Hello World! I'm Winson, an InfoSec student at SIT with a strong interest in computer networks and cybersecurity.
      </p>
      <p>
        Lately, I've been delving into Security Operations (SOC), threat hunting, and detection engineering after discovering a passion for blue team operations during my internship.
      </p>
      <p>
        Open to internships, collaborations, and interesting projects.
      </p>
    </div>

    <div class="mt-10">
      <p class="text-ink-soft mb-3 font-mono text-xs tracking-[0.2em] uppercase">Skills</p>
      <ul class="flex flex-wrap gap-2">
        {
          tools.map((tool) => (
            <li class="border-line text-ink-soft rounded-full border px-3 py-1 font-mono text-xs">
              {tool}
            </li>
          ))
        }
      </ul>
    </div>

    <Button href={`mailto:${SITE.email}`} class="mt-10">Get in touch</Button>
  </section>
</BaseLayout>
