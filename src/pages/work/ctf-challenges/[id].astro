---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import FlagForm from '@/components/FlagForm.astro';
import { withBase } from '@/utils/url';

export async function getStaticPaths() {
  const entries = await getCollection('ctf');
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'ctf'>;
}

const { entry } = Astro.props;
const { title, summary, category, event, tags, flagSalt, flagHash, flagFormat } = entry.data;
const { Content } = await render(entry);
---

<BaseLayout title={title} description={summary}>
  <article class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <a
      href={withBase('/work/ctf-challenges')}
      class="text-ink-soft hover:text-signal font-mono text-xs transition-colors"
    >
      ← All CTF challenges
    </a>

    <h1 class="font-display text-ink mt-6 max-w-2xl text-3xl font-medium sm:text-4xl">
      {title}
    </h1>

    <dl
      class="border-line text-ink-soft mt-6 flex flex-wrap gap-x-8 gap-y-2 border-y py-4 font-mono text-xs"
    >
      <div><dt class="inline">Category — </dt><dd class="inline">{category}</dd></div>
      {event && <div><dt class="inline">Event — </dt><dd class="inline">{event}</dd></div>}
      {
        tags.length > 0 && (
          <div>
            <dt class="inline">Topics — </dt>
            <dd class="inline">{tags.join(', ')}</dd>
          </div>
        )
      }
    </dl>

    <div class="prose prose-sm sm:prose-base mt-10 max-w-2xl">
      <Content />
    </div>

    {flagSalt && flagHash && <FlagForm salt={flagSalt} hash={flagHash} format={flagFormat} />}
  </article>
</BaseLayout>
