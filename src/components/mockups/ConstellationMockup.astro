---
import { withBase } from '@/utils/url';
---

<div class="mockup-wrapper">
<div class="tarot-wrapper">
      <div class="tarot-carousel">
        
        <!-- Card 1: The Observatory -->
        <div class="tarot-card card-observatory">
          <div class="tarot-art">
            <img src={withBase('/images/v3/theobservatory.png')} alt="The Observatory" />
          </div>
          <div class="tarot-info">
            <span class="tarot-num">XXIII</span>
            <h4>The Observatory</h4>
            <p>Gathers the faint light of distant anomalies from the stellar stream.</p>
          </div>
        </div>

        <!-- Card 2: The Astrolabe -->
        <div class="tarot-card card-astrolabe">
          <div class="tarot-art">
            <img src={withBase('/images/v3/theastrolabe.png')} alt="The Astrolabe" />
          </div>
          <div class="tarot-info">
            <span class="tarot-num">XXV</span>
            <h4>The Astrolabe</h4>
            <p>Translates disjointed sparks into meaningful, structured cosmic movement.</p>
          </div>
        </div>

        <!-- Card 3: The Oracle -->
        <div class="tarot-card card-oracle">
          <div class="tarot-art">
            <img src={withBase('/images/v3/theoracle.png')} alt="The Oracle" />
          </div>
          <div class="tarot-info">
            <span class="tarot-num">XXVI</span>
            <h4>The Oracle</h4>
            <p>Matches emerging patterns against the forbidden catalogue of fates.</p>
          </div>
        </div>

        <!-- Card 4: The Planetarium -->
        <div class="tarot-card card-planetarium">
          <div class="tarot-art">
            <img src={withBase('/images/v3/theplanetarium.png')} alt="The Planetarium" />
          </div>
          <div class="tarot-info">
            <span class="tarot-num">XXVII</span>
            <h4>The Planetarium</h4>
            <p>Visualizes the evolving constellations across the night sky in real-time.</p>
          </div>
        </div>

      </div>
      <div class="carousel-hint">Swipe to unveil the arcana →</div>
    </div>
</div>

<style>

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    .mockup-wrapper {
      --bg: var(--color-paper);
      --bg-card: var(--color-surface);
      --bg-surface: var(--color-line);
      --text: var(--color-ink);
      --text-muted: var(--color-ink-soft);
      --text-faint: var(--color-ink-soft);
      --border: var(--color-line);
      --border-med: var(--color-line);
      --green-fill: #EAF3DE;
      --green-border: #3B6D11;
      --green-text: #27500A;
      --accent: var(--color-signal);
      --font: var(--font-body);
      --mono: var(--font-mono);
      --radius: 10px;
      --radius-lg: 14px;
    }

    :global(.dark) .mockup-wrapper {
        --bg: var(--color-paper);
        --bg-card: var(--color-surface);
        --bg-surface: var(--color-line);
        --text: var(--color-ink);
        --text-muted: var(--color-ink-soft);
        --text-faint: var(--color-ink-soft);
        --border: var(--color-line);
        --border-med: var(--color-line);
        --green-fill: #17290d;
        --green-border: #3B6D11;
        --green-text: #97C459;
        --accent: var(--color-signal);
      }

    .mockup-wrapper {
      font-family: var(--font);
      background: var(--bg);
      color: var(--text);
      font-size: 15px;
      line-height: 1.6;
      min-height: 100vh;
      padding: 2rem;
    }

    .container { max-width: 900px; margin: 0 auto; }

    nav { margin-bottom: 3rem; display: flex; align-items: center; gap: 1rem; }
    .back-link {
      font-size: 13px; color: var(--text-muted); text-decoration: none;
      display: inline-flex; align-items: center; gap: 5px;
      transition: color 0.15s;
    }
    .back-link:hover { color: var(--text); }

    h1 { font-size: 32px; font-weight: 300; letter-spacing: -0.02em; margin-bottom: 0.5rem; }
    .subtitle { color: var(--text-muted); margin-bottom: 2rem; max-width: 600px; font-style: italic; }

    /* BADGES */
    .badge-row { display: flex; gap: 0.8rem; margin-bottom: 2rem; flex-wrap: wrap; }
    .badge {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 4px 12px; border-radius: 99px; background: var(--bg-surface);
      font-size: 12px; font-weight: 500; color: var(--text);
      border: 0.5px solid var(--border);
    }

    /* SECTIONS */
    section { margin-bottom: 4rem; }
    .section-label {
      font-size: 10px; color: var(--text-faint);
      letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 1.5rem;
    }

    /* TAROT CAROUSEL */
    .tarot-wrapper { margin-top: 1rem; position: relative; }
    .tarot-carousel {
      display: flex; gap: 1rem; overflow-x: auto; padding: 0.5rem 0.25rem 2.5rem;
      scroll-snap-type: x mandatory; scrollbar-width: none;
    }
    .tarot-carousel::-webkit-scrollbar { display: none; }

    .tarot-card {
      flex: 0 0 220px; scroll-snap-align: center;
      border-radius: 6px; overflow: hidden;
      border: 0.5px solid var(--border);
      background: var(--bg-card);
      box-shadow: 0 4px 18px rgba(0,0,0,0.1);
      transition: transform 0.35s cubic-bezier(0.23, 1, 0.32, 1),
                  box-shadow 0.35s cubic-bezier(0.23, 1, 0.32, 1);
      cursor: grab;
    }

    .tarot-info {
      padding: 1rem 1.25rem 1.25rem;
      border-top: 0.5px solid var(--border);
      text-align: center;
    }
    .tarot-num {
      display: block; font-size: 10px; font-family: var(--mono);
      color: var(--text-faint); letter-spacing: 0.25em;
      margin-bottom: 0.5rem;
    }
    .tarot-info h4 { font-size: 13px; font-weight: 500; color: var(--text); margin-bottom: 0.35rem; }
    .tarot-info p { font-size: 11px; color: var(--text-muted); line-height: 1.6; }
    .tarot-card:hover {
      transform: translateY(-6px) scale(1.02);
      box-shadow: 0 14px 32px rgba(0,0,0,0.16);
    }
    .tarot-card:active { cursor: grabbing; }

    .tarot-art { display: block; }
    .tarot-art img {
      width: 100%; height: auto; display: block;
      transition: transform 0.7s cubic-bezier(0.23, 1, 0.32, 1);
    }
    .tarot-card:hover .tarot-art img { transform: scale(1.04); }

    .carousel-hint {
      text-align: center; font-size: 10px; color: var(--text-faint);
      text-transform: uppercase; letter-spacing: 0.2em; margin-top: 0;
    }

    /* CODE BLOCKS */
    .code-block {
      background: var(--bg-surface); border-radius: var(--radius);
      padding: 1.25rem; font-family: var(--mono); font-size: 12px;
      color: var(--text-muted); line-height: 1.6;
      border: 0.5px solid var(--border); margin: 1rem 0;
      overflow-x: auto;
    }
    .keyword { color: #cf222e; }
    .comment { color: #6e7781; }

    /* ROADMAP */
    .roadmap-list { list-style: none; }
    .roadmap-item {
      display: flex; gap: 1.5rem; margin-bottom: 1.5rem;
      padding-left: 1rem; border-left: 1.5px solid var(--border-med);
    }
    .roadmap-phase {
      font-size: 11px; font-weight: 600; color: var(--text-faint);
      text-transform: uppercase; width: 80px; flex-shrink: 0;
      padding-top: 2px;
    }
    .roadmap-content h4 { font-size: 14px; font-weight: 500; margin-bottom: 0.25rem; }
    .roadmap-content p { font-size: 13px; color: var(--text-muted); }

    @media (max-width: 768px) {
      .tarot-card { flex: 0 0 200px; }
      .arch-arrow { transform: rotate(90deg); margin: 0.5rem 0; }
    }
  
</style>
