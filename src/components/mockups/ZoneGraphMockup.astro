<script is:inline>

  const zoneGraphRoot = document.querySelector('[data-zone-graph]');

  const phases = [
    'Infrastructure Setup',
    'DNS Enumeration',
    'CT Log Analysis',
    'Live HTTP Probing',
    'VHost Fuzzing & Redirects',
    'Graph Visualization',
  ];

  const track = zoneGraphRoot.querySelector('#carouselTrack');
  const dots = zoneGraphRoot.querySelectorAll('.dot');
  const btnPrev = zoneGraphRoot.querySelector('#btnPrev');
  const btnNext = zoneGraphRoot.querySelector('#btnNext');
  const progressLabel = zoneGraphRoot.querySelector('#progressLabel');
  const phaseTitle = zoneGraphRoot.querySelector('#phaseTitle');

  let current = 0;

  function carouselGo(n) {
    current = Math.max(0, Math.min(phases.length - 1, n));
    track.style.transform = `translateX(-${current * 100}%)`;
    dots.forEach((d, i) => d.classList.toggle('active', i === current));
    btnPrev.disabled = current === 0;
    btnNext.disabled = current === phases.length - 1;
    progressLabel.textContent = `PHASE ${current} / ${phases.length - 1}`;
    phaseTitle.textContent = phases[current];
  }

  document.addEventListener('keydown', e => {
    if (e.key === 'ArrowRight') carouselGo(current + 1);
    if (e.key === 'ArrowLeft')  carouselGo(current - 1);
  });

  // Touch/swipe support
  let touchStartX = 0;
  track.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; }, { passive: true });
  track.addEventListener('touchend', e => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 40) carouselGo(current + (dx < 0 ? 1 : -1));
  }, { passive: true });

</script>
